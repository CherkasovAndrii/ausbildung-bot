# Скопируй этот файл в .env и впиши токен от @BotFather
BOT_TOKEN=

# Telegram ID владельца бота (можно несколько через ;). Необязательно: если не задан,
# владельцем станет единственный подписчик, а если подписчиков нет — тот, кто отправит
# боту /claim <код> (код появится в логах при запуске).
OWNER_ID=

# Профессии по умолчанию для нового подписчика (через ;).
# Дальше каждый меняет их в боте: /settings → Профессии
SEARCH_TERMS=Fachinformatiker Systemintegration;Fachinformatiker Anwendungsentwicklung;Kaufmann für Digitalisierungsmanagement

# Как часто проверять новые вакансии, в часах
CHECK_INTERVAL_HOURS=6

# Сколько описаний вакансий загружать за один заход и как часто (минуты)
ENRICH_BATCH=300
ENRICH_INTERVAL_MIN=10
