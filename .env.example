# Скопируй этот файл в .env и впиши токен от @BotFather
BOT_TOKEN=

# Поисковые запросы через точку с запятой
SEARCH_TERMS=Fachinformatiker Systemintegration;Fachinformatiker Anwendungsentwicklung;Kaufmann für Digitalisierungsmanagement

# Город или PLZ. Пусто = вся Германия. UMKREIS — радиус в км вокруг WO
WO=
UMKREIS=50

# Не присылать вакансии, в названии которых есть эти слова (через ;)
# пример: EXCLUDE_WORDS=Duales Studium;Bachelor
EXCLUDE_WORDS=

# Не присылать вакансии с началом раньше этой даты (ГГГГ-ММ-ДД). Пусто = все
MIN_START=

# Как часто проверять, в часах
CHECK_INTERVAL_HOURS=6

# При первом запуске в чат уходят только вакансии, опубликованные за столько дней
FIRST_RUN_DAYS=3

# Максимум вакансий в одной рассылке
MAX_NOTIFY=60
